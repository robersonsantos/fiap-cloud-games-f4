    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fcg-notifications-worker</UserSecretsId>
    <RootNamespace>FCG.Notifications.Worker</RootNamespace>
